            <column caption='grupo_edad' datatype='string' name='[Calculation_0056114972217344]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [edad] &lt;= 18 THEN &apos;Niños (0-18)&apos;&#13;&#10;ELSEIF [edad] &lt;= 35 THEN &apos;Jóvenes (19-35)&apos;&#13;&#10;ELSEIF [edad] &lt;= 50 THEN &apos;Adultos (36-50)&apos;&#13;&#10;ELSEIF [edad] &lt;= 65 THEN &apos;Adultos maduros (51-65)&apos;&#13;&#10;ELSE &apos;Adultos mayores (66+)&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;Adultos (36-50)&quot;' value='(36-50) Adultos ' />
                <alias key='&quot;Adultos maduros (51-65)&quot;' value='(51-65) Adultos maduros ' />
                <alias key='&quot;Adultos mayores (66+)&quot;' value='(66+) Adultos mayores ' />
                <alias key='&quot;Jóvenes (19-35)&quot;' value='(19-35) Jóvenes' />
                <alias key='&quot;Niños (0-18)&quot;' value='(0-18) Niños' />
