      </column>
      <column caption='hizo_star' datatype='boolean' name='[Calculation_2326606136999942]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [client_id], [fecha] : MAX(IF [paso] = &apos;start&apos; THEN TRUE ELSE FALSE END) }' />
      </column>
      <column caption='hizo_confirm' datatype='boolean' name='[Calculation_2326606137831431]' role='dimension' type='nominal'>
