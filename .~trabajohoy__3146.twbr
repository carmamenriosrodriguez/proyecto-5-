      <column caption='Tasa finalización' datatype='real' default-format='p0.0%' name='[Calculation_1977099215122432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF {FIXED [client_id] : MAX(IF [paso] = &apos;confirm&apos; THEN 1 ELSE 0 END)} = 1 &#10;THEN [client_id] &#10;END) &#10;/ &#10;COUNTD(IF [paso] = &apos;start&apos; THEN [client_id] END)' />
      </column>
      <column caption='hizo_star' datatype='boolean' name='[Calculation_2326606136999942]' role='dimension' type='nominal'>
